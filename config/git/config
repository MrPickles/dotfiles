[alias]
	br = branch
	ci = commit
	co = checkout
	di = diff
	st = status
[apply]
	whitespace = nowarn
[branch]
	sort = -committerdate
[color]
	branch = auto
	diff = auto
	status = auto
[column]
	ui = auto
[commit]
	verbose = true
[core]
	pager = delta 2> /dev/null || less
[delta]
	line-numbers = true
	navigate = true
	features = tokyonight-storm
[delta "tokyonight-storm"]
	# Vendored from https://github.com/folke/tokyonight.nvim/blob/5da1b76e64daf4c5d410f06bcb6b9cb640da7dfd/extras/delta/tokyonight_storm.gitconfig
	syntax-theme = tokyonight_storm
	minus-style = syntax "#52313f"
	minus-non-emph-style = syntax "#52313f"
	minus-emph-style = syntax "#763842"
	minus-empty-line-marker-style = syntax "#52313f"
	line-numbers-minus-style = "#914c54"
	plus-style = syntax "#2b485a"
	plus-non-emph-style = syntax "#2b485a"
	plus-emph-style = syntax "#316172"
	plus-empty-line-marker-style = syntax "#2b485a"
	line-numbers-plus-style = "#449dab"
	line-numbers-zero-style = "#3b4261"
[delta "tokyonight-day"]
	# Vendored from https://github.com/folke/tokyonight.nvim/blob/5da1b76e64daf4c5d410f06bcb6b9cb640da7dfd/extras/delta/tokyonight_day.gitconfig
	syntax-theme = tokyonight_day
	minus-style = syntax "#dababe"
	minus-non-emph-style = syntax "#dababe"
	minus-emph-style = syntax "#d59a9d"
	minus-empty-line-marker-style = syntax "#dababe"
	line-numbers-minus-style = "#c47981"
	plus-style = syntax "#b7ced5"
	plus-non-emph-style = syntax "#b7ced5"
	plus-emph-style = syntax "#95bec7"
	plus-empty-line-marker-style = syntax "#b7ced5"
	line-numbers-plus-style = "#4197a4"
	line-numbers-zero-style = "#a8aecb"
[diff]
	algorithm = histogram
	colorMoved = plain
	mnemonicPrefix = true
	renames = true
[fetch]
	all = true
	prune = true
	pruneTags = true
[format]
	pretty = %C(auto)%h%Creset -%C(auto)%d%Creset %s %C(blue)<%an> %Cgreen(%cr)%Creset
[ghq]
	root = ~/Developer
	user = MrPickles
[help]
	autocorrect = prompt
[init]
	defaultBranch = main
[interactive]
	diffFilter = delta --color-only
[merge]
	conflictstyle = zdiff3
[pull]
	ff = only
[push]
	autoSetupRemote = true
	default = simple
	followTags = true
[rebase]
	autoSquash = true
	autoStash = true
	updateRefs = true
[rerere]
	autoupdate = true
	enabled = true
[tag]
	sort = version:refname
[url "git@github.com:"]
	pushInsteadOf = "https://github.com/"
