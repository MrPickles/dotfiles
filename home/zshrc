################################################################################
# Terminal color mode (light vs dark)
################################################################################

# Default to Tokyo Night Storm; switch to Day when the terminal is light.
() {
  emulate -L zsh
  setopt extendedglob

  typeset -g DOTFILES_TOKYONIGHT_STYLE=storm
  typeset -g DOTFILES_INSTANT_PROMPT=verbose

  # Codex is intentionally light and does not use P10k's shared instant-prompt cache.
  if [[ ${CODEX_SHELL:-} == 1 ]]; then
    typeset -g DOTFILES_TOKYONIGHT_STYLE=day
    typeset -g DOTFILES_INSTANT_PROMPT=off
    return
  fi

  [[ -o interactive ]] || return
  # This tmux setup is always dark; avoid unreliable OSC passthrough.
  [[ -z ${TMUX:-} ]] || return
  [[ $TERM != (dumb|linux|vt[0-9]*|sun*) ]] || return
  [[ -e /dev/tty && -r /dev/tty && -w /dev/tty ]] || return
  zmodload zsh/system 2>/dev/null && (( $+builtins[sysread] )) || return

  local saved buf
  saved=$(command stty -g </dev/tty 2>/dev/null) || return
  # Restore the tty on every exit path.
  trap 'command stty "$saved" </dev/tty 2>/dev/null; trap - EXIT INT TERM HUP' EXIT INT TERM HUP
  # Keep signals enabled while preparing the tty for a bounded read.
  command stty -echo -icanon min 0 time 1 </dev/tty 2>/dev/null || return

  printf '%s' $'\e]11;?\a' >/dev/tty
  sysread -t 0.25 -s 256 buf </dev/tty
  command stty "$saved" </dev/tty 2>/dev/null
  trap - EXIT INT TERM HUP

  [[ ${(L)buf} == (#b)*rgb:([0-9a-f]##)/([0-9a-f]##)/([0-9a-f]##)* ]] || return
  local r=$match[1] g=$match[2] b=$match[3]
  (( ${#r} == 1 )) && r=$r$r
  (( ${#g} == 1 )) && g=$g$g
  (( ${#b} == 1 )) && b=$b$b
  typeset -i R=16#${r[1,2]} G=16#${g[1,2]} B=16#${b[1,2]}
  # Classify backgrounds above 0.5 relative luminance as light.
  (( 2126 * R + 7152 * G + 722 * B > 1275000 )) || return
  typeset -g DOTFILES_TOKYONIGHT_STYLE=day
}

# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
# Initialization code that may require console input (password prompts, [y/n]
# confirmations, etc.) must go above this block; everything else may go below.
if [[ ${DOTFILES_INSTANT_PROMPT:-verbose} != off &&
      -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# Re-apply after macOS /etc/zprofile `path_helper`, which reorders PATH on login shells.
_setup_path

################################################################################
# Oh-My-ZSH prerequisite setup
################################################################################

# Set OMZ installation location.
ZSH=$HOME/.oh-my-zsh
# Update OMZ via ./setup.sh, not a random interactive shell.
DISABLE_AUTO_UPDATE=true
# Skip fpath permission audit (compaudit). Single-user machine.
ZSH_DISABLE_COMPFIX=true
# Set zsh theme to be powerlevel10k with patched fontawesome symbols.
POWERLEVEL9K_MODE='nerdfont-v3'
ZSH_THEME='powerlevel10k/powerlevel10k'
# OMZ messes with the ls colors by default. Let's not have it do that.
DISABLE_LS_COLORS=true
export LS_COLORS=
# Advertise truecolor support when the terminal does not set COLORTERM.
[[ -n ${COLORTERM:-} ]] || export COLORTERM=truecolor

# These are the default OMZ plugins that we'll install.
plugins=(
  git
  brew
  history-substring-search
  colored-man-pages
  vi-mode
  fast-syntax-highlighting
  zsh-autosuggestions
  async
)

# Conditionally add fzf-tab if fzf is installed.
if _has fzf; then
  plugins+=(fzf-tab)
fi

################################################################################
# Source Oh-My-ZSH.
################################################################################

# All theme and plugin configs must come beforehand.
# Sourcing this may have side-effects, so order matters.
# For the most part, it seems like bindkey gets overwritten.
# Hence they must be after the OMZ sourcing.
source $ZSH/oh-my-zsh.sh

################################################################################
# FZF setup
################################################################################

if _has fzf; then
  if _has fd; then
    # Use fd for fzf.
    FZF_DEFAULT_COMMAND='fd --type f --follow --hidden --exclude .git'
    FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
    # Use fd for fzf directory search.
    FZF_ALT_C_COMMAND='fd --type d --color never'
  fi

  # Bind alt-j/k/d/u to moving the preview window for fzf.
  FZF_DEFAULT_OPTS="--bind alt-k:preview-up,alt-j:preview-down,alt-u:preview-page-up,alt-d:preview-page-down"

  # Color options only; layout and bindings stay local.
  # Storm: https://github.com/folke/tokyonight.nvim/blob/5da1b76e64daf4c5d410f06bcb6b9cb640da7dfd/extras/fzf/tokyonight_storm.sh
  typeset -ga TOKYONIGHT_FZF_COLORS_STORM=(
    '--color=bg+:#2e3c64'
    '--color=bg:#1f2335'
    '--color=border:#29a4bd'
    '--color=fg:#c0caf5'
    '--color=gutter:#1f2335'
    '--color=header:#ff9e64'
    '--color=hl+:#2ac3de'
    '--color=hl:#2ac3de'
    '--color=info:#545c7e'
    '--color=marker:#ff007c'
    '--color=pointer:#ff007c'
    '--color=prompt:#2ac3de'
    '--color=query:#c0caf5:regular'
    '--color=scrollbar:#29a4bd'
    '--color=separator:#ff9e64'
    '--color=spinner:#ff007c'
  )
  # Day: https://github.com/folke/tokyonight.nvim/blob/5da1b76e64daf4c5d410f06bcb6b9cb640da7dfd/extras/fzf/tokyonight_day.sh
  typeset -ga TOKYONIGHT_FZF_COLORS_DAY=(
    '--color=bg+:#b7c1e3'
    '--color=bg:#d0d5e3'
    '--color=border:#4094a3'
    '--color=fg:#3760bf'
    '--color=gutter:#d0d5e3'
    '--color=header:#b15c00'
    '--color=hl+:#188092'
    '--color=hl:#188092'
    '--color=info:#8990b3'
    '--color=marker:#d20065'
    '--color=pointer:#d20065'
    '--color=prompt:#188092'
    '--color=query:#3760bf:regular'
    '--color=scrollbar:#4094a3'
    '--color=separator:#b15c00'
    '--color=spinner:#d20065'
  )
  if [[ $DOTFILES_TOKYONIGHT_STYLE == day ]]; then
    typeset -ga TOKYONIGHT_FZF_COLORS=("${TOKYONIGHT_FZF_COLORS_DAY[@]}")
  else
    typeset -ga TOKYONIGHT_FZF_COLORS=("${TOKYONIGHT_FZF_COLORS_STORM[@]}")
  fi
  FZF_DEFAULT_OPTS+=" ${(j: :)TOKYONIGHT_FZF_COLORS}"
  zstyle ':fzf-tab:*' fzf-flags "${TOKYONIGHT_FZF_COLORS[@]}"

  # Show previews for files and directories.
  FZF_CTRL_T_OPTS="--preview 'cat {} | head -200'"
  if _has batcat; then
    FZF_CTRL_T_OPTS="--preview 'batcat --style=numbers --color=always {} | head -200'"
  elif _has bat; then
    FZF_CTRL_T_OPTS="--preview 'bat --style=numbers --color=always {} | head -200'"
  fi

  # Some basic fzf-tab configs.
  zstyle ':completion:*:descriptions' format '[%d]'
  zstyle ':fzf-tab:*' switch-group ',' '.'

  if _has eza; then
    zstyle ':fzf-tab:complete:cd:*' fzf-preview 'eza --tree --icons --color=always $realpath'

    # Display source tree and file preview for ALT-C.
    FZF_ALT_C_OPTS="--preview 'eza --tree --icons --level 3 --color=always --group-directories-first {} | head -200'"
  fi
fi

################################################################################
# Editor aliases
################################################################################

# Use Neovim instead of classic Vim (if available)
if _has nvim; then
  alias vim="nvim"
  alias vi="nvim"
fi

################################################################################
# Tmux setup
################################################################################

# Use 256 color for tmux.
alias tmux="TERM=screen-256color-bce tmux"
# Attempt to take over existing sessions before creating a new tmux session.
t() {
  tmux -u new -ADs ${1:-tmux}
}

################################################################################
# Set up other environment variables, aliases, and options
################################################################################

ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE="bg=italic,underline"

# Match delta's theme to the terminal.
export DELTA_FEATURES="tokyonight-${DOTFILES_TOKYONIGHT_STYLE}"

# The bat executable may sometimes be called batcat on Debian/Ubuntu.
export BAT_THEME="tokyonight_${DOTFILES_TOKYONIGHT_STYLE}"
if _has batcat; then
  alias bat="batcat"
fi
if _has bat; then
  alias cat="bat"
fi

# Set shell options.
setopt correct # enable spelling suggestions
setopt rmstarsilent # silence rm * confirmation

# Decrease delay in entering normal mode in shell.
# https://www.johnhawthorn.com/2012/09/vi-escape-delays/
KEYTIMEOUT=10

################################################################################
# Actions with side-effects after sourcing Oh-My-ZSH
################################################################################

# Set key bindings.
bindkey -v # vi mode for shell
bindkey -e # enable C-x-e for shell editor
# Key bindings for history search.
bindkey '\e[3~' delete-char
bindkey '^R' history-incremental-search-backward
# Explicitly bind home and end keys (in case of terminal compatibility issues)
[[ -n ${terminfo[khome]:-} ]] && bindkey "${terminfo[khome]}" beginning-of-line
[[ -n ${terminfo[kend]:-} ]] && bindkey "${terminfo[kend]}" end-of-line

# Discard late-arriving OSC 11 background query responses so they don't leak into the prompt
_discard_osc11() {
  local char
  while read -s -k 1 -t 0.05 char; do
    [[ $char == $'\a' || $char == $'\\' ]] && break
  done
}
zle -N _discard_osc11
bindkey -M emacs $'\e]11;' _discard_osc11 2>/dev/null || true
bindkey -M viins $'\e]11;' _discard_osc11 2>/dev/null || true
bindkey -M vicmd $'\e]11;' _discard_osc11 2>/dev/null || true

# Alias `eza` as default `ls` command (if available).
# This must come after OMZ. (The library overwrites this alias.)
export EZA_CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/eza/${DOTFILES_TOKYONIGHT_STYLE}"
if _has eza; then
  alias ls="eza --icons=auto"
fi

# Sourcing OMZ overwrites some of bindings from fzf scripts.
# setup.sh requires fzf >= 0.48, which is when `--zsh` was added.
if _has fzf; then
  source <(fzf --zsh)
fi

if _has zoxide; then
  eval "$(zoxide init --cmd cd zsh)"
fi

# To customize prompt, run `p10k configure` or edit ~/.p10k.zsh.
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh

# Source local zshrc configs.
if [[ -f ~/.zshrc.local ]]; then
  source ~/.zshrc.local
fi
